# ── AnnaSetu Environment Configuration ──

# App
NODE_ENV=development
APP_PORT=3000

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=annasetu
POSTGRES_USER=annasetu
POSTGRES_PASSWORD=changeme

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Hyperledger Fabric
FABRIC_CHANNEL=annasetu-channel
FABRIC_CHAINCODE=surplus-food-cc
FABRIC_ORG=DonorOrg
FABRIC_MSP=DonorOrgMSP

# Polygon
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_PRIVATE_KEY=your_private_key_here
POLYGON_CHAIN_ID=80002
ANNASETU_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Aadhaar (Mock for dev)
UIDAI_API_URL=http://localhost:8001
UIDAI_API_KEY=mock_aadhaar_key

# ONDC
ONDC_GATEWAY_URL=https://pilot-gateway-01.beckn.nsdl.co.in
ONDC_SUBSCRIBER_ID=annasetu.donor.example.com
ONDC_SIGNING_KEY=your_signing_key_here

# e-RUPI / NPCI (Mock for dev)
NPCI_API_URL=http://localhost:3005
NPCI_MERCHANT_ID=ANNASETU001
NPCI_API_KEY=mock_npci_key

# IDBI Bank Escrow
IDBI_ACCOUNT_NO=your_escrow_account
IDBI_API_URL=http://localhost:3007
IDBI_API_KEY=mock_idbi_key

# JWT
JWT_SECRET=annasetu_jwt_secret_change_in_prod
JWT_EXPIRES_IN=24h

# Food Credit Config
DEFAULT_PHH_CREDIT_INR=1000
DEFAULT_AAY_CREDIT_INR=1500
MAX_BALANCE_INR=10000
