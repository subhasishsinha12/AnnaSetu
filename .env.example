# AnnaSetu Environment Configuration
# Copy to .env and fill in your values

# App
NODE_ENV=development
APP_NAME=AnnaSetu

# --- LAYER 01: Donor API ---
DONOR_API_PORT=3001
MONGO_URI=mongodb://localhost:27017/annasetu_donors
EXPIRY_THRESHOLD_HOURS_PERISHABLE=48
EXPIRY_THRESHOLD_DAYS_PACKAGED=7

# --- LAYER 02: ONDC ---
ONDC_PORT=3002
ONDC_GATEWAY_URL=https://staging.registry.ondc.org
ONDC_SUBSCRIBER_ID=annasetu.idbibank.co.in
ONDC_SIGNING_PRIVATE_KEY=your_ed25519_private_key_here

# --- LAYER 03: Blockchain ---
FABRIC_CA_URL=http://localhost:7054
FABRIC_ORDERER_URL=grpc://localhost:7050
FABRIC_PEER_URL=grpc://localhost:7051
FABRIC_CHANNEL=annasetu-channel
FABRIC_CHAINCODE=annasetu
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
POLYGON_PRIVATE_KEY=your_polygon_wallet_private_key_here

# --- LAYER 04: Identity ---
IDENTITY_API_PORT=8001
UIDAI_SANDBOX_URL=https://developer.uidai.gov.in/uidaiauthws/1.6/
UIDAI_AUA_CODE=your_aua_code_here
NFSA_API_URL=https://nfsa.gov.in/api/v1
NFSA_API_KEY=your_nfsa_api_key_here

# --- LAYER 05: Finance ---
FINANCE_API_PORT=3003
ERUPI_API_URL=https://sandbox.npci.org.in/erupi/v1
ERUPI_CLIENT_ID=your_erupi_client_id_here
ERUPI_CLIENT_SECRET=your_erupi_client_secret_here
UPI_VPA=annasetu@idbi
IDBI_BANK_CODE=0004

# --- LAYER 06: Beneficiary ---
VITE_API_BASE_URL=http://localhost:3001
VITE_FINANCE_API_URL=http://localhost:3003

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=change_this_to_a_strong_secret
JWT_EXPIRY=24h
